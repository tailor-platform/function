  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailor-platform/function-types": "workspace:*",
    "@tailor-platform/sdk": "2.38.0",
    "@tsconfig/recommended": "1.0.13",
    "kysely": "0.29.8",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "kysely": ">= 0.24.0 < 1"
  }
}
